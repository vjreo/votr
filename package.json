{
  "name": "votr",
  "version": "1.0.0",
  "description": "VOTR — nonpartisan Mecklenburg ballot guide",
  "private": true,
  "workspaces": [
    "backend",
    "mobile"
  ],
  "overrides": {
    "react-native-screens": "4.16.0"
  },
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:mobile": "cd mobile && npm start",
    "dev": "npm run dev:backend",
    "start:backend": "cd backend && npm start",
    "start:mobile": "cd mobile && npm start",
    "install:all": "npm install && cd backend && npm install && cd ../mobile && npm install",
    "db:migrate": "cd backend && npm run db:migrate",
    "tunnel:backend": "npx ngrok http 3000"
  },
  "keywords": [
    "voting",
    "civic-engagement",
    "politics",
    "democracy"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {}
}

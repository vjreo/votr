# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/votr
# Or use individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=votr
DB_USER=your_db_user
DB_PASSWORD=your_secure_password

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m

# Google Civic Information API
GOOGLE_CIVIC_API_KEY=your-google-civic-api-key

# ML/AI Services
OPENAI_API_KEY=sk-your-openai-api-key
HUGGINGFACE_API_KEY=hf_your-huggingface-api-key

# Optional: External Bias APIs (if you have subscriptions)
# MEDIA_BIAS_FACT_CHECK_API_KEY=
# ALLSIDES_API_KEY=

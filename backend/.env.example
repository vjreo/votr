# Copy to .env and fill in your values
# Database: use DATABASE_URL for production (Render, Railway, etc.) or individual vars for local
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=votr
DB_USER=your_username
DB_PASSWORD=

# Server
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# CORS — comma-separated list of allowed origins (production only; dev allows all)
# Mobile apps typically send no Origin header; set if you have a web app.
# ALLOWED_ORIGINS=https://votr.app,https://www.votr.app

# JWT (required - generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-32-byte-hex-in-production
JWT_EXPIRES_IN=15m

# Open States API (required for NC - live state legislators)
# Free at https://openstates.org/accounts/signup/ → Profile → API Key
OPEN_STATES_API_KEY=your_key

# Optional: ML/AI for bias detection (app works without these)
# OPENAI_API_KEY=
# HUGGINGFACE_API_KEY=

{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.votr.app/api",
        "EXPO_PUBLIC_MVP_MODE": "true"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.votr.app/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
